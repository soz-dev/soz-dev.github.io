# SOZ-DEV — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# --- Admin (Supabase) ---
# Supabase > Settings > API
VITE_ADMIN_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_ADMIN_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email autorisé (le vôtre uniquement). Plusieurs : email1,email2
VITE_ADMIN_ALLOWED_EMAIL=sofyan.devpro@gmail.com

# Accès : https://soz-dev.com/admin (URL privée)
# IMPORTANT dans Supabase :
# 1) Authentication > Providers > Email > Enable sign ups = OFF
# 2) Exécuter supabase/schema.sql (RLS limitée à cet email)

# --- Contact / Devis (envoi email automatique, sans mailto) ---
# 1) Créer un compte gratuit sur https://web3forms.com
# 2) Créer une Access Key liée à sofyan.devpro@gmail.com (ou l’email souhaité)
# 3) Coller la clé ci-dessous
# 4) En production : ajouter le même secret dans GitHub → Settings → Secrets → Actions
VITE_WEB3FORMS_ACCESS_KEY=votre_access_key_web3forms
# Destinataire affiché dans l’UI / messages d’aide (l’email réel est celui lié à la clé Web3Forms)
VITE_CONTACT_EMAIL=sofyan.devpro@gmail.com

# --- Analytics (optionnel) ---
# Sans VITE_ANALYTICS_ID : aucun script chargé (no-op).
# Exemple Plausible : le domaine du site tel qu’enregistré chez Plausible.
# VITE_ANALYTICS_ID=soz-dev.com
# VITE_ANALYTICS_PROVIDER=plausible
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
#
# Provider custom (ex. autre outil) :
# VITE_ANALYTICS_PROVIDER=custom
# VITE_ANALYTICS_GLOBAL=monTracker
